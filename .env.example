# Firestore Configuration
GCP_PROJECT_ID=wolfiero-dev
FIRESTORE_EMULATOR_HOST=firestore-emulator:8080
GOOGLE_APPLICATION_CREDENTIALS=

# Logging
LOG_LEVEL=INFO
TZ=America/New_York

# Market Data
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=

# News (optional - leave empty to skip)
NEWS_PROVIDER=
NEWS_API_KEY=

# AI Provider (claude or bedrock)
AI_PROVIDER=claude
AI_API_KEY=
AI_MODEL=claude-opus-5

# Bedrock (optional, required if AI_PROVIDER=bedrock)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-20250514-v1:0

# Telegram (REQUIRED - get token from @BotFather, chat ID from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Strategy Parameters
STRATEGY_VERSION=v1.0.0
ACCOUNT_EQUITY_USD=100000
RISK_PER_TRADE_PCT=1.0
MIN_SETUP_QUALITY=0.45
UNIVERSE_MIN_DOLLAR_VOLUME=20000000
UNIVERSE_MIN_PRICE=5.00
SCAN_MAX_CANDIDATES=20
MIN_REWARD_RISK=2.0
MAX_PORTFOLIO_HEAT_PCT=6.0
MAX_POSITIONS=8
MAX_SECTOR_EXPOSURE_PCT=30.0
HOLD_WINDOW_DAYS=15
EARNINGS_POLICY=veto

# Scheduling (Eastern Time)
PREMARKET_RUN_TIME=05:30
REPORT_SEND_TIME=07:00
INTRADAY_INTERVAL_MINUTES=5
EOD_REPORT_TIME=16:30

# Data Quality
MIN_DATA_COVERAGE_PCT=90.0
MAX_DATA_STALENESS_DAYS=3
MAX_DAILY_MOVE_PCT=50.0

# Monitoring
WATCHDOG_CHECK_TIME=07:15

# API
WOLFIERO_API_KEY=prod-key

# Grounding
GROUNDING_GUARD_MODE=log
